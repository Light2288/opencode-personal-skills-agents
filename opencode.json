{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ibm-ica": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "IBM ICA",
      "options": {
        "baseURL": "{file:~/.config/opencode/ibm-ica-baseurl}"
      },
      "models": {
        "claude-opus-5": {
          "name": "Claude Opus 5",
          "attachment": true,
          "modalities": {
            "input": ["text", "image", "pdf"],
            "output": ["text"]
          }
        },
        "gpt-5.6-sol": {
          "name": "OpenAI GPT-5.6 Sol",
          "attachment": true,
          "modalities": {
            "input": ["text", "image", "pdf"],
            "output": ["text"]
          }
        },
        "claude-opus-4-6": {
          "name": "Claude Opus 4.6",
          "attachment": true,
          "modalities": {
            "input": ["text", "image", "pdf"],
            "output": ["text"]
          }
        },
        "claude-sonnet-5": {
          "name": "Claude Sonnet 5",
          "attachment": true,
          "modalities": {
            "input": ["text", "image", "pdf"],
            "output": ["text"]
          }
        },
        "claude-sonnet-4-6": {
          "name": "Claude Sonnet 4.6",
          "attachment": true,
          "modalities": {
            "input": ["text", "image", "pdf"],
            "output": ["text"]
          }
        },
        "gpt-5.6-luna": {
          "name": "OpenAI GPT-5.6 Luna (free)",
          "attachment": false,
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        },
        "ibm/granite-4-h-small": {
          "name": "Granite 4H Small (free)",
          "attachment": false,
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        },
        "meta-llama/llama-4-maverick-17b-128e-instruct-fp8": {
          "name": "Llama 4 Maverick 17B FP8 (free)",
          "attachment": false,
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        },
        "gemma-4-26b-a4b-it": {
          "name": "Gemma 4 26B Preview (free)",
          "attachment": false,
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        }
      }
    }
  },
  "model": "ibm-ica/gpt-5.6-sol",
  "small_model": "ibm-ica/gpt-5.6-luna",
  "instructions": ["AGENTS.md"],
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "agent": {
    "explore": {
      "model": "ibm-ica/gpt-5.6-luna"
    },
    "general": {
      "model": "ibm-ica/gpt-5.6-luna"
    },
    "title": {
      "model": "ibm-ica/gpt-5.6-luna"
    },
    "summary": {
      "model": "ibm-ica/gpt-5.6-luna"
    }
  }
}
